<?xml version="1.0" encoding="UTF-8"?>

<!-- The docinfo block is the analogue to the latex preamble -->
<!-- This is where you can define macros and other book-wide -->
<!-- settings. -->
<docinfo xmlns:xi="http://www.w3.org/2001/XInclude">
  <!-- A unique name for the book in a catalog; for example, see https://pretextbook.org/catalog.html and https://runestone.academy/ns/books/index. It contains a simple lowercase string with no dashes or other special characters. See https://pretextbook.org/doc/guide/html/sec-publishing-to-runestone-academy.html for more information. -->
  <document-id>changeme</document-id>
  <!-- A brief description for the book in a catalog; see the links above. The @shelf is used only when publishing to Runestone; see https://runestone.academy/ns/books/index for a list of valid values. You must copy these @shelf names exactly, including capitalization. -->
  <blurb shelf="An open source textbook for finite math or other class appropriate for the liberal arts."> A simple string (no markup is allowed) to describe your book. </blurb>
  
  <!-- For title into HTML head, then tabs, bookmarks, etc -->
  <initialism>Math for Society:</initialism>
 
  <!-- The next three lines are likely for mature projects only: -->

  <!-- <brandlogo url="" source="images/cover.png"/> -->
  <!-- <covers front="images/front.pdf" back="images/back.pdf"/> -->
  <document-id edition="1.0">WWU-Math for Society</document-id>

  <!-- macros for defining latex math shortcuts. It is good practice -->
  <!-- to define these semantically, so that the macro relates to what-->
  <!-- it defines. -->
  <macros> \newcommand{\N}{\mathbb N} \newcommand{\Z}{\mathbb Z} \newcommand{\Q}{\mathbb Q} \newcommand{\R}{\mathbb R} </macros>

  <!-- If you put any latex-image elements you can include preambles -->
  <!-- for those in the next element. -->
  <latex-image-preamble> 
    \usepackage{tikz, pgfplots} 
    \usepackage{venndiagram} 
    \usetikzlibrary{positioning,matrix,arrows} 
    \usetikzlibrary{shapes,decorations,shadows,fadings,patterns} 
    \usetikzlibrary{decorations.markings} 
    \usetikzlibrary{calc} 
    \pgfplotsset{compat=1.18} 
    \definecolor{CustomB1}{RGB}{17,117,167}
    \definecolor{CustomB2}{RGB}{60,84,111}
    \usepackage[parfill]{parskip} % no indent skip line between paragraphs
    %
    % FONTS. This preamble is used twice: to compile each latex-image alone
    % into a web SVG, and (pasted into the book's preamble) for the PDF,
    % where the TikZ code is recompiled inline. Every graphic sets its text
    % with \figfont, so the graphics font is chosen here, per output.
    % Math in graphics uses the document's math font (Computer Modern now).
    % \divisionfont is defined by PreTeXt's PDF preamble only.
    \ifdefined\divisionfont
      % PDF: print fonts go here; point \figfont at the family the
      % graphics should use (e.g. \rmfamily to match the body text).
      \usepackage{libertine}
      \usepackage[defaultsans]{opensans}
      \newcommand{\figfont}{\sffamily}
    \else
      % Web SVGs: Open Sans, to match the HTML body text, for ALL labels:
      % mathastext sets math letters, digits and ( ) = + / in the text
      % font, so $A$, $A^C$, $1/4$ match the plain-text labels. fontspec's
      % no-math keeps it from resetting math digits to Latin Modern.
      \PassOptionsToPackage{no-math}{fontspec}
      \usepackage[defaultsans]{opensans}
      \renewcommand{\familydefault}{\sfdefault}
      \usepackage[italic]{mathastext}
      \newcommand{\figfont}{\sffamily}
    \fi
    % pgfplots numbers (tick labels, nodes near coords) as text, not math,
    % so they take the axis's font=\figfont setting
    \pgfplotsset{/pgf/number format/assume math mode=true}
  </latex-image-preamble>

  <!-- It is possible to rename elements: -->
  <!-- <rename element="assemblage" xml:lang="en-US">Summary</rename> -->

  <!-- Specify the default type of cross reference: -->
  <!-- <cross-references text="type-global" /> -->


</docinfo>
